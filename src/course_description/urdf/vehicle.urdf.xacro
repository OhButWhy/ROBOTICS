<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════════
       Параметры (значения из .course-kit/v1/models/course_ackermann/model.sdf)
       ═══════════════════════════════════════════════════════════════ -->
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width"  value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="body_z"      value="0.12"/>
  <xacro:property name="body_mass"   value="12.0"/>

  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width"  value="0.07"/>
  <xacro:property name="wheel_mass"   value="0.8"/>

  <xacro:property name="knuckle_x"    value="0.40"/>
  <xacro:property name="knuckle_y"    value="0.31"/>
  <xacro:property name="knuckle_mass" value="0.2"/>

  <!-- позиции сенсоров по SDF; здесь отличаются для наглядности в RViz -->
  <xacro:property name="camera_x" value="0.40"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.25"/>

  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="${body_z + body_height/2 + 0.08}"/>

  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="${body_z}"/>

  <xacro:property name="sensor_mass" value="0.0333"/>

  <!-- ═══════════════════════════════════════════════════════════════
       Макросы инерции (стандартные формулы, физ. допустимые)
       ═══════════════════════════════════════════════════════════════ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m/12*(y*y+z*z)}" ixy="0" ixz="0"
        iyy="${m/12*(x*x+z*z)}" iyz="0"
        izz="${m/12*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Цилиндр с осью вдоль Y (так ориентированы колёса) -->
  <xacro:macro name="cylinder_inertia_y" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m/12*(3*r*r+h*h)}" ixy="0" ixz="0"
        iyy="${m*r*r/2}" iyz="0"
        izz="${m/12*(3*r*r+h*h)}"/>
    </inertial>
  </xacro:macro>

  <!-- ═══════════════════════════════════════════════════════════════
       КОРПУС
       ═══════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.05 0.36 0.72 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <!-- ═══════════════════════════════════════════════════════════════
       КАМЕРА  (fixed, parent = base_link)
       ═══════════════════════════════════════════════════════════════ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.05 0.05"/>
      </geometry>
      <material name="camera_red">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.05 0.05"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${sensor_mass}" x="0.08" y="0.05" z="0.05"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════
       ЛИДАР  (fixed, parent = base_link)   ← эту связь будем «ломать»
       ═══════════════════════════════════════════════════════════════ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${sensor_mass}"/>
      <inertia ixx="0.000333" ixy="0" ixz="0"
               iyy="0.000333" iyz="0"
               izz="0.000333"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════
       IMU  (fixed, parent = base_link)
       ═══════════════════════════════════════════════════════════════ -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.1 0.8 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${sensor_mass}" x="0.05" y="0.05" z="0.02"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════
       ПЕРЕДНЯЯ ОСЬ: knuckle (revolute Z) + wheel (continuous Y)
       ═══════════════════════════════════════════════════════════════ -->
  <xacro:macro name="front_assembly" params="prefix y_pos">
    <link name="${prefix}_knuckle">
      <inertial>
        <mass value="${knuckle_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0"
                 iyy="0.001" iyz="0"
                 izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_knuckle"/>
      <origin xyz="${knuckle_x} ${y_pos} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1.0"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_knuckle"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:front_assembly prefix="front_left"  y_pos="${knuckle_y}"/>
  <xacro:front_assembly prefix="front_right" y_pos="${-knuckle_y}"/>

  <!-- ═══════════════════════════════════════════════════════════════
       ЗАДНЯЯ ОСЬ: wheel (continuous Y), parent = base_link
       ═══════════════════════════════════════════════════════════════ -->
  <xacro:macro name="rear_wheel" params="prefix y_pos">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${-knuckle_x} ${y_pos} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel prefix="rear_left"  y_pos="${knuckle_y}"/>
  <xacro:rear_wheel prefix="rear_right" y_pos="${-knuckle_y}"/>

</robot>